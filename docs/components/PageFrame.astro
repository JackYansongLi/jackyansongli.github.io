---
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
import type { Props } from '@astrojs/starlight/props';

const props = Astro.props as Props;
const { hasSidebar } = props;
---

<div class="page sl-flex">
  <header class="header"><slot name="header" /></header>
  {
    hasSidebar && (
      <nav class="sidebar" aria-label="侧边栏导航">
        <MobileMenuToggle {...props} />
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </div>
        <button
          class="sidebar-toggle"
          type="button"
          aria-controls="starlight__sidebar"
          aria-expanded="true"
          aria-label="收起侧边栏"
          data-sidebar-toggle
        >
          <span aria-hidden="true">‹</span>
        </button>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>
  <button
    class="right-sidebar-toggle"
    type="button"
    aria-controls="starlight__right-sidebar"
    aria-expanded="true"
    aria-label="收起本页目录"
    data-right-sidebar-toggle
    hidden
  >
    <span aria-hidden="true">›</span>
  </button>
</div>

<script is:inline>
  const storageKey = 'sidebar-collapsed';
  const rightSidebarStorageKey = 'right-sidebar-collapsed';
  const root = document.documentElement;
  const toggle = document.querySelector('[data-sidebar-toggle]');
  const rightSidebar = document.querySelector('.right-sidebar-container');
  const rightSidebarToggle = document.querySelector('[data-right-sidebar-toggle]');

  const setCollapsed = (collapsed) => {
    root.toggleAttribute('data-sidebar-collapsed', collapsed);
    toggle.setAttribute('aria-expanded', String(!collapsed));
    toggle.setAttribute('aria-label', collapsed ? '展开侧边栏' : '收起侧边栏');
    toggle.querySelector('span').textContent = collapsed ? '›' : '‹';
  };

  if (toggle && window.matchMedia('(min-width: 50rem)').matches) {
    setCollapsed(localStorage.getItem(storageKey) === 'true');
    toggle.addEventListener('click', () => {
      const collapsed = !root.hasAttribute('data-sidebar-collapsed');
      setCollapsed(collapsed);
      localStorage.setItem(storageKey, String(collapsed));
    });
  }

  if (rightSidebar && rightSidebarToggle && window.matchMedia('(min-width: 50rem)').matches) {
    rightSidebar.id = 'starlight__right-sidebar';
    rightSidebarToggle.hidden = false;

    const setRightSidebarCollapsed = (collapsed) => {
      root.toggleAttribute('data-right-sidebar-collapsed', collapsed);
      rightSidebarToggle.setAttribute('aria-expanded', String(!collapsed));
      rightSidebarToggle.setAttribute('aria-label', collapsed ? '展开本页目录' : '收起本页目录');
      rightSidebarToggle.querySelector('span').textContent = collapsed ? '‹' : '›';
    };

    setRightSidebarCollapsed(localStorage.getItem(rightSidebarStorageKey) === 'true');
    rightSidebarToggle.addEventListener('click', () => {
      const collapsed = !root.hasAttribute('data-right-sidebar-collapsed');
      setRightSidebarCollapsed(collapsed);
      localStorage.setItem(rightSidebarStorageKey, String(collapsed));
    });
  }

  document.querySelectorAll('mjx-container[display="true"]').forEach((equation) => {
    equation.style.removeProperty('min-width');
  });
</script>

<style>
  .page {
    flex-direction: column;
    min-height: 100vh;
  }

  .header {
    z-index: var(--sl-z-index-navbar);
    position: fixed;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    height: var(--sl-nav-height);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
    background-color: var(--sl-color-bg-nav);
  }

  .sidebar-pane {
    visibility: var(--sl-sidebar-visibility, hidden);
    position: fixed;
    z-index: var(--sl-z-index-menu);
    inset-block: var(--sl-nav-height) 0;
    inset-inline-start: 0;
    width: 100%;
    background-color: var(--sl-color-black);
    overflow-y: auto;
  }

  :global([aria-expanded='true']) ~ .sidebar-pane {
    --sl-sidebar-visibility: visible;
  }

  .sidebar-content {
    height: 100%;
    min-height: max-content;
    padding: 1rem var(--sl-sidebar-pad-x) 0;
    flex-direction: column;
    gap: 1rem;
  }

  .main-frame {
    padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    padding-inline-start: var(--sl-content-inline-start);
  }

  .sidebar-toggle {
    display: none;
  }

  .right-sidebar-toggle {
    display: none;
  }

  @media (min-width: 50rem) {
    .header {
      padding-inline-end: var(--sl-nav-pad-x);
    }

    .sidebar-pane {
      --sl-sidebar-visibility: visible;
      width: var(--sl-sidebar-width);
      background-color: var(--sl-color-bg-sidebar);
      border-inline-end: 1px solid var(--sl-color-hairline-shade);
      transition: transform 180ms ease;
    }

    .sidebar-toggle {
      display: grid;
      position: fixed;
      z-index: calc(var(--sl-z-index-menu) + 1);
      inset-inline-start: calc(var(--sl-sidebar-width) - 0.8rem);
      inset-block-start: calc(var(--sl-nav-height) + 1rem);
      width: 1.6rem;
      height: 2.5rem;
      place-items: center;
      border: 1px solid var(--sl-color-hairline-shade);
      border-radius: 0 0.5rem 0.5rem 0;
      background: var(--sl-color-bg-sidebar);
      color: var(--sl-color-text);
      cursor: pointer;
      transition: inset-inline-start 180ms ease;
    }

    .right-sidebar-toggle {
      display: grid;
      position: fixed;
      z-index: calc(var(--sl-z-index-menu) + 1);
      inset-inline-end: calc(var(--sl-sidebar-width) - 0.8rem);
      inset-block-start: calc(var(--sl-nav-height) + 1rem);
      width: 1.6rem;
      height: 2.5rem;
      place-items: center;
      border: 1px solid var(--sl-color-hairline-shade);
      border-radius: 0.5rem 0 0 0.5rem;
      background: var(--sl-color-bg-sidebar);
      color: var(--sl-color-text);
      cursor: pointer;
      transition: inset-inline-end 180ms ease;
    }

    :global(html[data-sidebar-collapsed]) .sidebar-pane {
      transform: translateX(-100%);
    }

    :global(html[data-sidebar-collapsed]) .main-frame {
      padding-inline-start: 0;
    }

    :global(html[data-sidebar-collapsed]) .sidebar-toggle {
      inset-inline-start: 0;
    }

    :global(html[data-right-sidebar-collapsed]) :global(.right-sidebar-container) {
      display: none;
    }

    :global(html[data-right-sidebar-collapsed]) .right-sidebar-toggle {
      inset-inline-end: 0;
    }
  }
</style>
